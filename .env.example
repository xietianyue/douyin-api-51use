# Generate a long random value and use the same value in toolbox-api later.
INTERNAL_API_TOKEN=replace-with-a-long-random-value

# Central cookie management. Generate the two platform tokens in the toolbox
# admin page. Never commit real token or cookie values.
COOKIE_CONFIG_URL=https://toolbox-api.51use.cn
COOKIE_REFRESH_INTERVAL_SECONDS=60
DOUYIN_COOKIE_CONFIG_TOKEN=
BILIBILI_COOKIE_CONFIG_TOKEN=

# Leave platform cookies empty unless a platform requires your own account session.
# Never commit this file after filling it and never send these values in chat.
DOUYIN_COOKIE=
# Prefer Base64 here because a raw TikTok Cookie may contain quotes, spaces,
# semicolons, JSON fragments, dollar signs, or other env-file syntax.
TIKTOK_COOKIE_B64=
# Legacy fallback. Leave empty when TIKTOK_COOKIE_B64 is configured.
TIKTOK_COOKIE=
BILIBILI_COOKIE=
